{
  "name": "grammar-based-parser-toolkit",
  "version": "2.0.0",
  "description": "Compose small Chevrotain grammar components into parsers that turn free-form strings into structured data. Ships with a full grammar for German opening hours.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test 'test/**/*.test.ts'",
    "example": "node examples/parse-list.ts",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "author": "Conrad Klaus",
  "license": "GPL-3.0-only",
  "dependencies": {
    "chevrotain": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
